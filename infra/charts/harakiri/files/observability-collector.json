{
  "extensions": {
    "bearertokenauth/ingress": {
      "token": "${env:HARAKIRI_COLLECTOR_TOKEN}"
    },
    "headers_setter/tenant": {
      "headers": [
        {
          "key": "AccountID",
          "from_context": "x-harakiri-tenant"
        },
        {
          "key": "ProjectID",
          "value": "0"
        }
      ]
    },
    "file_storage/queue": {
      "directory": "/var/lib/otelcol/queue",
      "create_directory": true,
      "fsync": true,
      "max_size": 33554432
    },
    "health_check": {
      "endpoint": "0.0.0.0:13133"
    }
  },
  "receivers": {
    "otlp": {
      "protocols": {
        "http": {
          "endpoint": "0.0.0.0:4318",
          "include_metadata": true,
          "max_request_body_size": 1048576,
          "auth": {
            "authenticator": "bearertokenauth/ingress"
          }
        }
      }
    }
  },
  "processors": {
    "memory_limiter": {
      "check_interval": "1s",
      "limit_mib": 192,
      "spike_limit_mib": 32
    },
    "filter/binding": {
      "error_mode": "propagate",
      "traces": {
        "span": [
          "otelcol.client.metadata[\"x-harakiri-tenant\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-tenant\"]) != 1",
          "otelcol.client.metadata[\"x-harakiri-org\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-org\"]) != 1",
          "otelcol.client.metadata[\"x-harakiri-run\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-run\"]) != 1",
          "otelcol.client.metadata[\"x-harakiri-sandbox\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-sandbox\"]) != 1",
          "otelcol.client.metadata[\"x-harakiri-capture\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-capture\"]) != 1",
          "not IsMatch(otelcol.client.metadata[\"x-harakiri-tenant\"][0], \"^[1-9][0-9]{0,8}$\")",
          "not IsMatch(otelcol.client.metadata[\"x-harakiri-run\"][0], \"^run_[A-Za-z0-9_-]{1,64}$\")",
          "not IsMatch(otelcol.client.metadata[\"x-harakiri-sandbox\"][0], \"^sbx_[A-Za-z0-9_-]{1,64}$\")",
          "otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"metadata\" and otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"content\""
        ]
      },
      "logs": {
        "log_record": [
          "otelcol.client.metadata[\"x-harakiri-tenant\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-tenant\"]) != 1",
          "otelcol.client.metadata[\"x-harakiri-org\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-org\"]) != 1",
          "otelcol.client.metadata[\"x-harakiri-run\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-run\"]) != 1",
          "otelcol.client.metadata[\"x-harakiri-sandbox\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-sandbox\"]) != 1",
          "otelcol.client.metadata[\"x-harakiri-capture\"] == nil",
          "Len(otelcol.client.metadata[\"x-harakiri-capture\"]) != 1",
          "not IsMatch(otelcol.client.metadata[\"x-harakiri-tenant\"][0], \"^[1-9][0-9]{0,8}$\")",
          "not IsMatch(otelcol.client.metadata[\"x-harakiri-run\"][0], \"^run_[A-Za-z0-9_-]{1,64}$\")",
          "not IsMatch(otelcol.client.metadata[\"x-harakiri-sandbox\"][0], \"^sbx_[A-Za-z0-9_-]{1,64}$\")",
          "otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"metadata\" and otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"content\""
        ]
      }
    },
    "transform/privacy": {
      "error_mode": "propagate",
      "trace_statements": [
        {
          "context": "span",
          "statements": [
            "keep_keys(resource.attributes, [\"service.name\", \"service.version\", \"telemetry.sdk.language\", \"telemetry.sdk.version\"])",
            "truncate_all(resource.attributes, 128)",
            "keep_keys(scope.attributes, [])",
            "set(resource.attributes[\"harakiri.org.id\"], otelcol.client.metadata[\"x-harakiri-org\"][0])",
            "set(resource.attributes[\"harakiri.run.id\"], otelcol.client.metadata[\"x-harakiri-run\"][0])",
            "set(resource.attributes[\"harakiri.sandbox.id\"], otelcol.client.metadata[\"x-harakiri-sandbox\"][0])",
            "set(resource.attributes[\"harakiri.capture\"], otelcol.client.metadata[\"x-harakiri-capture\"][0])",
            "set(resource.attributes[\"harakiri.source\"], \"workload\")",
            "set(resource.attributes[\"harakiri.schema.version\"], \"1\")",
            "delete_key(span.attributes, \"harakiri.content.truncated\") where span.attributes[\"harakiri.content.truncated\"] != true",
            "keep_keys(span.attributes, [\"gen_ai.operation.name\",\"gen_ai.provider.name\",\"gen_ai.system\",\"gen_ai.request.model\",\"gen_ai.response.model\",\"gen_ai.usage.input_tokens\",\"gen_ai.usage.output_tokens\",\"gen_ai.tool.name\",\"error.type\",\"gen_ai.request.temperature\",\"gen_ai.request.top_p\",\"gen_ai.request.max_tokens\",\"gen_ai.response.finish_reasons\",\"gen_ai.response.id\",\"gen_ai.tool.call.id\",\"gen_ai.usage.cache_read.input_tokens\",\"gen_ai.usage.cache_creation.input_tokens\",\"gen_ai.usage.reasoning.output_tokens\",\"harakiri.llm.first_token_ms\",\"harakiri.command.id\",\"harakiri.step.kind\",\"harakiri.attempt\",\"harakiri.content.truncated\",\"openinference.span.kind\",\"llm.model_name\",\"llm.token_count.prompt\",\"llm.token_count.completion\",\"tool.name\",\"gen_ai.input.messages\",\"gen_ai.output.messages\",\"gen_ai.tool.call.arguments\",\"gen_ai.tool.call.result\",\"gen_ai.system_instructions\",\"gen_ai.tool.definitions\"])",
            "keep_keys(span.attributes, [\"gen_ai.operation.name\",\"gen_ai.provider.name\",\"gen_ai.system\",\"gen_ai.request.model\",\"gen_ai.response.model\",\"gen_ai.usage.input_tokens\",\"gen_ai.usage.output_tokens\",\"gen_ai.tool.name\",\"error.type\",\"gen_ai.request.temperature\",\"gen_ai.request.top_p\",\"gen_ai.request.max_tokens\",\"gen_ai.response.finish_reasons\",\"gen_ai.response.id\",\"gen_ai.tool.call.id\",\"gen_ai.usage.cache_read.input_tokens\",\"gen_ai.usage.cache_creation.input_tokens\",\"gen_ai.usage.reasoning.output_tokens\",\"harakiri.llm.first_token_ms\",\"harakiri.command.id\",\"harakiri.step.kind\",\"harakiri.attempt\",\"harakiri.content.truncated\",\"openinference.span.kind\",\"llm.model_name\",\"llm.token_count.prompt\",\"llm.token_count.completion\",\"tool.name\"]) where otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"content\"",
            "set(span.attributes[\"harakiri.content.truncated\"], true) where IsString(span.attributes[\"gen_ai.input.messages\"]) and Len(span.attributes[\"gen_ai.input.messages\"]) > 32768",
            "set(span.attributes[\"harakiri.content.truncated\"], true) where IsString(span.attributes[\"gen_ai.output.messages\"]) and Len(span.attributes[\"gen_ai.output.messages\"]) > 32768",
            "set(span.attributes[\"harakiri.content.truncated\"], true) where IsString(span.attributes[\"gen_ai.tool.call.arguments\"]) and Len(span.attributes[\"gen_ai.tool.call.arguments\"]) > 32768",
            "set(span.attributes[\"harakiri.content.truncated\"], true) where IsString(span.attributes[\"gen_ai.tool.call.result\"]) and Len(span.attributes[\"gen_ai.tool.call.result\"]) > 32768",
            "set(span.attributes[\"harakiri.content.truncated\"], true) where IsString(span.attributes[\"gen_ai.system_instructions\"]) and Len(span.attributes[\"gen_ai.system_instructions\"]) > 32768",
            "set(span.attributes[\"harakiri.content.truncated\"], true) where IsString(span.attributes[\"gen_ai.tool.definitions\"]) and Len(span.attributes[\"gen_ai.tool.definitions\"]) > 32768",
            "truncate_all(span.attributes, 32768)",
            "set(span.trace_state, \"\")",
            "set(span.status.message, \"\") where otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"content\"",
            "set(span.events, nil) where otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"content\"",
            "set(span.links, nil) where otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"content\""
          ]
        }
      ],
      "log_statements": [
        {
          "context": "log",
          "statements": [
            "keep_keys(resource.attributes, [\"service.name\", \"service.version\", \"telemetry.sdk.language\", \"telemetry.sdk.version\"])",
            "truncate_all(resource.attributes, 128)",
            "keep_keys(scope.attributes, [])",
            "set(resource.attributes[\"harakiri.org.id\"], otelcol.client.metadata[\"x-harakiri-org\"][0])",
            "set(resource.attributes[\"harakiri.run.id\"], otelcol.client.metadata[\"x-harakiri-run\"][0])",
            "set(resource.attributes[\"harakiri.sandbox.id\"], otelcol.client.metadata[\"x-harakiri-sandbox\"][0])",
            "set(resource.attributes[\"harakiri.capture\"], otelcol.client.metadata[\"x-harakiri-capture\"][0])",
            "set(resource.attributes[\"harakiri.source\"], \"workload\")",
            "set(resource.attributes[\"harakiri.schema.version\"], \"1\")",
            "delete_key(log.attributes, \"harakiri.content.truncated\") where log.attributes[\"harakiri.content.truncated\"] != true",
            "keep_keys(log.attributes, [\"gen_ai.operation.name\",\"gen_ai.provider.name\",\"gen_ai.system\",\"gen_ai.request.model\",\"gen_ai.response.model\",\"gen_ai.usage.input_tokens\",\"gen_ai.usage.output_tokens\",\"gen_ai.tool.name\",\"error.type\",\"gen_ai.request.temperature\",\"gen_ai.request.top_p\",\"gen_ai.request.max_tokens\",\"gen_ai.response.finish_reasons\",\"gen_ai.response.id\",\"gen_ai.tool.call.id\",\"gen_ai.usage.cache_read.input_tokens\",\"gen_ai.usage.cache_creation.input_tokens\",\"gen_ai.usage.reasoning.output_tokens\",\"harakiri.llm.first_token_ms\",\"harakiri.command.id\",\"harakiri.step.kind\",\"harakiri.attempt\",\"harakiri.content.truncated\",\"openinference.span.kind\",\"llm.model_name\",\"llm.token_count.prompt\",\"llm.token_count.completion\",\"tool.name\",\"gen_ai.input.messages\",\"gen_ai.output.messages\",\"gen_ai.tool.call.arguments\",\"gen_ai.tool.call.result\",\"gen_ai.system_instructions\",\"gen_ai.tool.definitions\"])",
            "keep_keys(log.attributes, [\"gen_ai.operation.name\",\"gen_ai.provider.name\",\"gen_ai.system\",\"gen_ai.request.model\",\"gen_ai.response.model\",\"gen_ai.usage.input_tokens\",\"gen_ai.usage.output_tokens\",\"gen_ai.tool.name\",\"error.type\",\"gen_ai.request.temperature\",\"gen_ai.request.top_p\",\"gen_ai.request.max_tokens\",\"gen_ai.response.finish_reasons\",\"gen_ai.response.id\",\"gen_ai.tool.call.id\",\"gen_ai.usage.cache_read.input_tokens\",\"gen_ai.usage.cache_creation.input_tokens\",\"gen_ai.usage.reasoning.output_tokens\",\"harakiri.llm.first_token_ms\",\"harakiri.command.id\",\"harakiri.step.kind\",\"harakiri.attempt\",\"harakiri.content.truncated\",\"openinference.span.kind\",\"llm.model_name\",\"llm.token_count.prompt\",\"llm.token_count.completion\",\"tool.name\"]) where otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"content\"",
            "set(log.attributes[\"harakiri.content.truncated\"], true) where IsString(log.attributes[\"gen_ai.input.messages\"]) and Len(log.attributes[\"gen_ai.input.messages\"]) > 32768",
            "set(log.attributes[\"harakiri.content.truncated\"], true) where IsString(log.attributes[\"gen_ai.output.messages\"]) and Len(log.attributes[\"gen_ai.output.messages\"]) > 32768",
            "set(log.attributes[\"harakiri.content.truncated\"], true) where IsString(log.attributes[\"gen_ai.tool.call.arguments\"]) and Len(log.attributes[\"gen_ai.tool.call.arguments\"]) > 32768",
            "set(log.attributes[\"harakiri.content.truncated\"], true) where IsString(log.attributes[\"gen_ai.tool.call.result\"]) and Len(log.attributes[\"gen_ai.tool.call.result\"]) > 32768",
            "set(log.attributes[\"harakiri.content.truncated\"], true) where IsString(log.attributes[\"gen_ai.system_instructions\"]) and Len(log.attributes[\"gen_ai.system_instructions\"]) > 32768",
            "set(log.attributes[\"harakiri.content.truncated\"], true) where IsString(log.attributes[\"gen_ai.tool.definitions\"]) and Len(log.attributes[\"gen_ai.tool.definitions\"]) > 32768",
            "truncate_all(log.attributes, 32768)",
            "set(log.body, \"\") where otelcol.client.metadata[\"x-harakiri-capture\"][0] != \"content\"",
            "set(log.body, String(log.body))",
            "set(log.attributes[\"harakiri.content.truncated\"], true) where Len(log.body) > 16384",
            "set(log.body, Substring(log.body, 0, 16384)) where Len(log.body) > 16384"
          ]
        }
      ]
    },
    "batch/tenant": {
      "metadata_keys": [
        "x-harakiri-tenant"
      ],
      "metadata_cardinality_limit": 128,
      "timeout": "200ms",
      "send_batch_size": 128,
      "send_batch_max_size": 256
    }
  },
  "exporters": {
    "otlp_http/logs": {
      "endpoint": "http://HARAKIRI_OBSERVABILITY-logs:9428/insert/opentelemetry",
      "auth": {
        "authenticator": "headers_setter/tenant"
      },
      "timeout": "5s",
      "retry_on_failure": {
        "initial_interval": "1s",
        "max_interval": "5s",
        "max_elapsed_time": "60s"
      },
      "sending_queue": {
        "storage": "file_storage/queue",
        "sizer": "bytes",
        "queue_size": 8388608,
        "num_consumers": 2,
        "block_on_overflow": false
      },
      "headers": {
        "VL-Stream-Fields": "service.name"
      }
    },
    "otlp_http/traces": {
      "endpoint": "http://HARAKIRI_OBSERVABILITY-traces:10428/insert/opentelemetry",
      "auth": {
        "authenticator": "headers_setter/tenant"
      },
      "timeout": "5s",
      "retry_on_failure": {
        "initial_interval": "1s",
        "max_interval": "5s",
        "max_elapsed_time": "60s"
      },
      "sending_queue": {
        "storage": "file_storage/queue",
        "sizer": "bytes",
        "queue_size": 8388608,
        "num_consumers": 2,
        "block_on_overflow": false
      }
    }
  },
  "service": {
    "extensions": [
      "bearertokenauth/ingress",
      "headers_setter/tenant",
      "file_storage/queue",
      "health_check"
    ],
    "telemetry": {
      "logs": {
        "level": "error"
      },
      "metrics": {
        "readers": [
          {
            "pull": {
              "exporter": {
                "prometheus": {
                  "host": "0.0.0.0",
                  "port": 8888
                }
              }
            }
          }
        ]
      }
    },
    "pipelines": {
      "logs": {
        "receivers": [
          "otlp"
        ],
        "processors": [
          "memory_limiter",
          "filter/binding",
          "transform/privacy",
          "batch/tenant"
        ],
        "exporters": [
          "otlp_http/logs"
        ]
      },
      "traces": {
        "receivers": [
          "otlp"
        ],
        "processors": [
          "memory_limiter",
          "filter/binding",
          "transform/privacy",
          "batch/tenant"
        ],
        "exporters": [
          "otlp_http/traces"
        ]
      }
    }
  }
}
