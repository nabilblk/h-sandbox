DATABASE_URL=postgres://harakiri:harakiri@127.0.0.1:15432/harakiri
API_PORT=8080
WEB_PORT=5173
LOCAL_POSTGRES_PORT=15432
LOCAL_KEYCLOAK_PORT=8081
PUBLIC_API_URL=http://127.0.0.1:8080
PUBLIC_KEYCLOAK_URL=http://127.0.0.1:8081
PUBLIC_KEYCLOAK_REALM=harakiri
PUBLIC_KEYCLOAK_CLIENT_ID=harakiri-web
# Optional. Requires http(s)://<web-host>/silent-check-sso.html to be registered
# as a valid redirect URI in Keycloak.
PUBLIC_KEYCLOAK_SILENT_CHECK_SSO=false
KEYCLOAK_ISSUER=http://127.0.0.1:8081/realms/harakiri
KEYCLOAK_ISSUER_ALLOWLIST=http://127.0.0.1:8081/realms/harakiri,http://127.0.0.1:18084/realms/harakiri
KEYCLOAK_JWKS_URL=http://127.0.0.1:8081/realms/harakiri/protocol/openid-connect/certs
OPEN_SANDBOX_BASE_URL=http://opensandbox-server.opensandbox-system.svc.cluster.local:80
OPEN_SANDBOX_API_KEY=dev-opensandbox-key
OPEN_SANDBOX_ALLOW_FALLBACK=1
HARAKIRI_RUNTIME_PROVIDER=dev
# Opt-in requires native retained-volume support and OPEN_SANDBOX_ALLOW_FALLBACK=0.
PERSISTENT_WORKSPACES_ENABLED=0
WORKSPACE_STORAGE_CLASS=
WORKSPACE_SIZE_GIB=10
WORKSPACE_MAX_PER_ORGANIZATION=20
PUBLIC_OPEN_SANDBOX_URL=http://127.0.0.1:18083
SANDBOX_ROUTE_MODE=local-proxy
SANDBOX_ROUTE_BASE_DOMAIN=sandbox.localhost
SANDBOX_ROUTE_PUBLIC_SCHEME=http
SANDBOX_ROUTE_LOCAL_FALLBACK_URL=http://127.0.0.1:18083
SANDBOX_MAX_ROUTES_PER_SANDBOX=8
SANDBOX_MAX_ROUTES_PER_ORG=200
SANDBOX_FILE_ARTIFACT_MAX_BYTES=16777216
TERMINAL_ATTACH_TICKET_TTL_SECONDS=60
# Optional environment-specific route TLS/DNS automation.
# See infra/scripts/env/harakiri/README.md for the harakiri.io example.
LETSENCRYPT_EMAIL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
HARAKIRI_SANDBOX_DNS_TARGET=
AUTH_DEV_ALLOW=1
