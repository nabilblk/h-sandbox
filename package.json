{
  "name": "harakiri-sandbox",
  "version": "0.5.0-rc.4",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "demo:capture": "pnpm --filter @harakiri/demo-video capture",
    "demo:cleanup": "pnpm --filter @harakiri/demo-video cleanup",
    "demo:approve": "pnpm --filter @harakiri/demo-video approve",
    "demo:studio": "pnpm --filter @harakiri/demo-video studio",
    "demo:render": "pnpm --filter @harakiri/demo-video render:workflows",
    "demo:verify": "pnpm --filter @harakiri/demo-video verify && pnpm --filter @harakiri/demo-video verify:workflows",
    "demo:test": "node --test examples/demo/product-tour/server.test.mjs && pnpm --filter @harakiri/demo-video test",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "cli:pack": "pnpm pack:cli",
    "pack:sdk": "mkdir -p dist-packages && pnpm --filter @h-sandbox/sdk build && pnpm --filter @h-sandbox/sdk pack --pack-destination dist-packages",
    "pack:cli": "mkdir -p dist-packages && pnpm --filter @h-sandbox/cli build && pnpm --filter @h-sandbox/cli pack --pack-destination dist-packages",
    "package:assert": "node scripts/assert-public-packages.mjs",
    "publish:dry-run": "pnpm --filter @h-sandbox/sdk build && pnpm --filter @h-sandbox/cli build && (cd packages/sdk && HARAKIRI_ALLOW_DIRTY_PUBLISH=1 pnpm publish --dry-run --access public --no-git-checks) && (cd packages/cli && HARAKIRI_ALLOW_DIRTY_PUBLISH=1 pnpm publish --dry-run --access public --no-git-checks)",
    "publish:local-check": "bash scripts/npm-package-smoke.sh",
    "publish:postcheck": "bash scripts/npm-postpublish-smoke.sh",
    "dev": "pnpm --parallel --filter @harakiri/api --filter @harakiri/web dev",
    "lint": "pnpm -r lint",
    "openapi:write": "pnpm --filter @harakiri/shared openapi:write",
    "openapi:check": "pnpm --filter @harakiri/shared openapi:check",
    "credential-vault:check": "node scripts/check-credential-vault-boundary.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "playwright test tests/e2e/harakiri.spec.ts",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "db:migrate": "pnpm --filter @harakiri/api db:migrate",
    "db:seed": "pnpm --filter @harakiri/api db:seed",
    "k0s:bootstrap": "bash infra/k0s/bootstrap.sh",
    "k0s:verify": "bash infra/k0s/verify.sh",
    "deploy:k0s": "bash infra/scripts/deploy-k0s.sh",
    "cert-manager:install": "bash infra/scripts/cert-manager-install.sh",
    "ports": "bash infra/scripts/port-forward.sh",
    "ports:stop": "bash infra/scripts/port-forward.sh stop",
    "ports:restart": "bash infra/scripts/port-forward.sh restart",
    "ports:status": "bash infra/scripts/port-forward.sh status",
    "smoke": "bash infra/scripts/smoke.sh",
    "smoke:members": "bash infra/scripts/member-invitation-smoke.sh",
    "smoke:ttl": "bash infra/scripts/ttl-smoke.sh",
    "smoke:lifecycle": "bash infra/scripts/lifecycle-smoke.sh",
    "smoke:lifecycle-persistence": "bash infra/scripts/lifecycle-persistence-smoke.sh",
    "smoke:filesystem": "bash infra/scripts/filesystem-smoke.sh",
    "smoke:process": "bash infra/scripts/process-smoke.sh",
    "smoke:renew": "bash infra/scripts/renew-smoke.sh",
    "smoke:templates": "bash infra/scripts/template-catalog-smoke.sh",
    "smoke:template-redaction": "bash infra/scripts/template-redaction-smoke.sh",
    "smoke:template-limits": "bash infra/scripts/template-limits-smoke.sh",
    "smoke:template-policy": "bash infra/scripts/template-image-policy-smoke.sh",
    "smoke:template-visibility": "bash infra/scripts/template-visibility-smoke.sh",
    "smoke:template-audit": "bash infra/scripts/template-audit-smoke.sh",
    "smoke:template-registry-credentials": "bash infra/scripts/template-registry-credentials-smoke.sh",
    "smoke:template-build": "bash infra/scripts/template-build-smoke.sh",
    "smoke:template-init": "bash infra/scripts/template-init-smoke.sh",
    "smoke:template-prepull": "bash infra/scripts/template-prepull-smoke.sh",
    "smoke:template-resolution": "bash infra/scripts/template-resolution-smoke.sh",
    "smoke:sandbox-env": "bash infra/scripts/sandbox-env-smoke.sh",
    "smoke:credential-vault": "bash infra/scripts/credential-vault-smoke.sh",
    "smoke:credential-vault-cli": "pnpm --filter @h-sandbox/cli build && bash infra/scripts/credential-vault-cli-smoke.sh",
    "route:tls-dev": "bash infra/scripts/route-tls-dev-secret.sh",
    "smoke:route": "bash infra/scripts/route-smoke.sh",
    "smoke:route-ingress": "bash infra/scripts/route-ingress-smoke.sh",
    "conformance": "pnpm conformance:sdk && pnpm conformance:cli",
    "conformance:dev": "bash tests/conformance/dev-runtime-smoke.sh",
    "conformance:sdk": "bash tests/conformance/sdk-runtime-smoke.sh",
    "conformance:cli": "bash tests/conformance/cli-runtime-smoke.sh",
    "examples:check": "find examples -path '*/index.mjs' -print | sort | xargs -n1 node --check && pnpm --filter @h-sandbox/sdk build && tsc -p examples/tsconfig.json",
    "templates:check": "find examples/templates -name smoke.sh -print | sort | xargs -n1 bash -n",
    "env:harakiri:deploy-public": "bash infra/scripts/env/harakiri/deploy-public.sh",
    "env:harakiri:cloudflare-dns": "bash infra/scripts/env/harakiri/cloudflare-sandbox-dns.sh",
    "env:harakiri:route-tls-letsencrypt": "bash infra/scripts/env/harakiri/route-tls-letsencrypt-cloudflare.sh",
    "env:harakiri:route-preflight": "bash infra/scripts/env/harakiri/route-preflight.sh",
    "env:harakiri:route-public": "bash infra/scripts/env/harakiri/route-public-smoke.sh"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.15.13",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
