      "post": {
        "summary": "Execute a command",
        "description": "Run a command in the remote Linux workspace. Python and Bash are installed. Returns a process ID; inspect its output before reporting completion.",
        "operationId": "run_command",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 300,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Seconds to wait for the command to finish before returning. If the command completes in time, output is included inline. Null to return immediately.",
              "title": "Wait"
            },
            "description": "Seconds to wait for the command to finish before returning. If the command completes in time, output is included inline. Null to return immediately."
          },
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Return only the last N output entries. Useful to limit response size when only recent output matters.",
              "title": "Tail"
            },
            "description": "Return only the last N output entries. Useful to limit response size when only recent output matters."
          }
