  },
  "components": {
    "schemas": {
      "ExecRequest": {
        "properties": {
          "command": {
            "type": "string",
            "title": "Command",
            "description": "Shell command to execute. Supports chaining (&&, ||, ;), pipes (|), and redirections.",
            "examples": [
              "echo hello",
              "ls -la && whoami"
            ]
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwd",
            "description": "Working directory for the command. Defaults to the server's current directory if not set."
          },
          "env": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Env",
            "description": "Extra environment variables merged into the subprocess environment."
          }
        },
        "type": "object",
        "required": [
          "command"
        ],
        "title": "ExecRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InputRequest": {
        "properties": {
          "input": {
            "type": "string",
            "title": "Input",
            "description": "Text to send to the process's stdin. Include newline characters as needed."
          }
        },
        "type": "object",
        "required": [
          "input"
        ],
        "title": "InputRequest"
      },
      "ReplaceRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Path to the file to modify."
          },
          "replacements": {
            "items": {
              "$ref": "#/components/schemas/ReplacementChunk"
            },
            "type": "array",
            "title": "Replacements",
            "description": "List of find-and-replace operations to apply sequentially."
          }
        },
        "type": "object",
        "required": [
          "path",
          "replacements"
        ],
        "title": "ReplaceRequest"
      },
      "ReplacementChunk": {
        "properties": {
          "target": {
            "type": "string",
            "title": "Target",
            "description": "Exact string to find. Must match precisely, including whitespace."
          },
          "replacement": {
            "type": "string",
            "title": "Replacement",
            "description": "Content to replace the target with."
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line",
            "description": "Narrow the search to lines at or after this (1-indexed)."
          },
          "end_line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End Line",
            "description": "Narrow the search to lines at or before this (1-indexed)."
          },
          "allow_multiple": {
            "type": "boolean",
            "title": "Allow Multiple",
            "description": "If true, replaces all occurrences. If false, errors when multiple matches are found.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "target",
          "replacement"
        ],
        "title": "ReplacementChunk"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WriteRequest": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Absolute or relative path to write to. Parent directories are created automatically."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Text content to write to the file."
          }
        },
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "title": "WriteRequest"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
