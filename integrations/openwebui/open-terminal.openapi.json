    "/files/grep": {
      "get": {
        "summary": "Search file contents",
        "description": "Search for a text pattern across files in a directory. Returns structured matches with file paths, line numbers, and matching lines. Skips binary files.",
        "operationId": "grep_search",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Text or regex pattern to search for.",
              "title": "Query"
            },
            "description": "Text or regex pattern to search for."
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Directory or file to search in.",
              "default": ".",
              "title": "Path"
            },
            "description": "Directory or file to search in."
          },
          {
            "name": "regex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Use regex. Set false for literal search.",
              "default": true,
              "title": "Regex"
            },
            "description": "Use regex. Set false for literal search."
          },
          {
            "name": "case_insensitive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Perform case-insensitive matching.",
              "default": false,
              "title": "Case Insensitive"
            },
            "description": "Perform case-insensitive matching."
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Glob patterns to filter files (e.g. '*.py'). Files must match at least one pattern.",
              "title": "Include"
            },
            "description": "Glob patterns to filter files (e.g. '*.py'). Files must match at least one pattern."
          },
          {
            "name": "match_per_line",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "If true, return each matching line with line numbers. If false, return only the names of matching files.",
              "default": true,
              "title": "Match Per Line"
            },
            "description": "If true, return each matching line with line numbers. If false, return only the names of matching files."
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Maximum number of matches to return.",
              "default": 50,
              "title": "Max Results"
            },
            "description": "Maximum number of matches to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Search path not found."
          },
          "400": {
            "description": "Invalid regex pattern."
          },
          "401": {
            "description": "Invalid or missing API key."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
