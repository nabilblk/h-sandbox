    "/files/read": {
      "get": {
        "summary": "Read a file",
        "description": "Read a file and return its contents. Supports text files and images (PNG, JPEG, WebP, etc.). For text files you can optionally request a specific line range. Images are returned as binary so you can view and analyze them directly. Use display_file to show a file to the user.",
        "operationId": "read_file",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Path to the file to read.",
              "title": "Path"
            },
            "description": "Path to the file to read."
          },
          {
            "name": "start_line",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "First line to return (1-indexed, inclusive). Defaults to the beginning of the file.",
              "title": "Start Line"
            },
            "description": "First line to return (1-indexed, inclusive). Defaults to the beginning of the file."
          },
          {
            "name": "end_line",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last line to return (1-indexed, inclusive). Defaults to the end of the file.",
              "title": "End Line"
            },
            "description": "Last line to return (1-indexed, inclusive). Defaults to the end of the file."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "File not found."
          },
          "415": {
            "description": "Unsupported binary file type."
          },
          "401": {
            "description": "Invalid or missing API key."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
