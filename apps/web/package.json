{
  "name": "@harakiri/web",
  "version": "0.5.0-rc.6",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm docs:export && vite build",
    "dev": "pnpm docs:export && vite --host 0.0.0.0",
    "docs:export": "tsx scripts/export-docs.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --import tsx src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@h-sandbox/sdk": "workspace:*",
    "@harakiri/shared": "workspace:*",
    "@vitejs/plugin-react": "^5.1.1",
    "highlight.js": "^11.12.0",
    "keycloak-js": "^26.2.4",
    "lowlight": "^3.3.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "5.0.6",
    "tsx": "^4.23.13",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  }
}
