{
  "name": "@harakiri/api",
  "version": "0.5.0-rc.5",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm --filter @harakiri/shared build && tsc -p tsconfig.json",
    "dev": "pnpm --filter @harakiri/shared build && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "scheduler": "node dist/scheduler.js",
    "template-builder": "node dist/template-builder.js",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "lint": "pnpm --filter @harakiri/shared build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @harakiri/shared build && node --test --import tsx src/*.test.ts",
    "typecheck": "pnpm --filter @harakiri/shared build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/websocket": "^11.2.0",
    "@harakiri/shared": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "fastify": "^5.12.3",
    "jose": "^6.1.2",
    "pg": "^8.16.3",
    "ws": "^8.21.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13"
  }
}
