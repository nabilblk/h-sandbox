{
  "name": "@h-sandbox/sdk",
  "version": "0.5.0-rc.15",
  "description": "TypeScript SDK for Harakiri Sandbox.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabilblk/h-sandbox.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/nabilblk/h-sandbox#readme",
  "bugs": {
    "url": "https://github.com/nabilblk/h-sandbox/issues"
  },
  "keywords": [
    "harakiri",
    "sandbox",
    "opensandbox",
    "agents",
    "sdk",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node ../../scripts/assert-publish-worktree.mjs && pnpm build && node ../../scripts/assert-public-packages.mjs sdk",
    "test": "node --test --import tsx src/*.test.ts",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "test:package": "node ../../scripts/test-sdk-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "tsx": "^4.23.13"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": { "optional": true },
    "@opentelemetry/exporter-logs-otlp-proto": { "optional": true },
    "@opentelemetry/exporter-trace-otlp-proto": { "optional": true },
    "@opentelemetry/resources": { "optional": true },
    "@opentelemetry/sdk-logs": { "optional": true },
    "@opentelemetry/sdk-trace": { "optional": true }
  },
  "dependencies": {
    "eventsource-parser": "^3.1.1"
  }
}
