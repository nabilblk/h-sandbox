{
  "name": "@h-sandbox/cli",
  "version": "0.3.1",
  "description": "Command-line client for Harakiri Sandbox.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "harakiri": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabilblk/h-sandbox.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nabilblk/h-sandbox#readme",
  "bugs": {
    "url": "https://github.com/nabilblk/h-sandbox/issues"
  },
  "keywords": [
    "harakiri",
    "sandbox",
    "opensandbox",
    "agents",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm --filter @h-sandbox/sdk build && pnpm clean && tsc -p tsconfig.json && node scripts/chmod.mjs",
    "dev": "pnpm --filter @h-sandbox/sdk build && tsx src/index.ts",
    "lint": "pnpm --filter @h-sandbox/sdk build && tsc -p tsconfig.json --noEmit",
    "pack:tgz": "pnpm build && pnpm pack --pack-destination ../../dist-packages",
    "prepublishOnly": "node ../../scripts/assert-publish-worktree.mjs && pnpm build && node ../../scripts/assert-public-packages.mjs cli",
    "test": "pnpm --filter @h-sandbox/sdk build && node --test --import tsx src/*.test.ts",
    "typecheck": "pnpm --filter @h-sandbox/sdk build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@h-sandbox/sdk": "workspace:*",
    "commander": "^15.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0"
  }
}
